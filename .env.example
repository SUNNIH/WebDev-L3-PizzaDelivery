# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/pizzadelivery

# CORS Configuration
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-characters-long-change-in-production
JWT_EXPIRY=2h

# CSRF Configuration
CSRF_SECRET=your-csrf-secret-min-32-characters-long-change-in-production

# Email Configuration (ethereal for dev, SMTP for production)
EMAIL_HOST=ethereal
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="SUNNYS Pizza <noreply@sunnyspizza.com>"

# Admin Provisioning (for createAdmin script)
ADMIN_EMAIL=admin@sunnyspizza.com
ADMIN_PASSWORD=secureAdminPassword123
